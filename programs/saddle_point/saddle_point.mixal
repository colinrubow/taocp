* TAOCP 1.3.2 ex 10, finds a saddle point in a 9x8 matrix
*
MATRIX	EQU	1009		The first element of the matrix
NUMROWS	EQU	9		number of rows
NUMCOLS	EQU	8		number of columns
	ORIG	0
MINROW	ORIG	*+18		gets the min address in the row
MAXCOL	ORIG	*+18		gets the max address in the column
FVROW	ORIG	*+19		finds a value in the row
MAIN	ORIG	*
**********
* implement MINROW
* rI2 will hold the min address and should be initialized with the first address of the row
* rI3 will be used to store the min value
* rI4 will be used to count comparisons
* rI5 will be used to store the next address
* rA is used
	ORIG	MINROW
	STJ	0F
* initialize
FIRSTA	ST2	*
TEMP	NOP
	LD3	0,2
	ENT4	NUMCOLS
NEXTMIN	DEC4	1
* checked all values?
	J4Z	0F
* is current min greater than the next value?
	ST4	TEMP
	LDA	FIRSTA
	ADD	TEMP
	STA	TEMP
	LD5	TEMP
	CMP3	0,5
	JLE	NEXTMIN
* swap for new min
	LD2	TEMP
	LD3	0,2
	JMP	NEXTMIN
* found the min
0H	JMP	*-*
**********
* implement MAXCOL
* rI2 will hold the max address and should be initialized with the first address of the column
* rI3 will be used to store the max value
* rI4 will be used to count comparisons
* rI5 will be used to store the next address
* rA is used
	ORIG	MAXCOL
	STJ	0F
* initialize
FIRSTM	ST2	*
TEMP2	NOP
	LD3	0,2
	ENT4	NUMCOLS*NUMROWS
NEXTMAX	DEC4	NUMCOLS
* checked all values?
	J4Z	0F
* is current max less than the next value?
	ST4	TEMP2
	LDA	FIRSTM
	ADD	TEMP2
	STA	TEMP2
	LD5	TEMP2
	CMP3	0,5
	JGE	NEXTMAX
* swap for new max
	LD2	TEMP2
	LD3	0,2
	JMP	NEXTMAX
* found the max
0H	JMP	*-*
**********
* implement FVROW
* rI2 should be initialized with the first address of the row. Will hold the address of the next value
* rI3 should be initialized with the value to search for
* rI4 should be initialized with the distance from the first address to start
* rI5 is used
* rA is used
	ORIG	FVROW
	STJ	0F
TEMP3	NOP
NEXTV	INC4	1
* checked all values?
	CMP4	=NUMCOLS=
	JE	NOFIND
* found one?
	ST2	TEMP3
	LDA	TEMP3
	ST4	TEMP3
	ADD	TEMP3
	STA	TEMP3
	LD5	TEMP3
	CMP3	0,5
	JNE	NEXTV
	JMP	FIND
* did not find one
NOFIND	ENT2	-1
	JMP	0F
* found one
FIND	LD2	TEMP3
	JMP	0F
0H	JMP	*-*
**********
* MAIN program
	ORIG	MAIN
	ENT6	MATRIX
	ENT1	0
* get row min
TEMP4	ST6	*
	LD2	TEMP4
	JMP	MINROW
ROWA	ST2	*
VAL	ST3	*
* get col max
	ST1	TEMP4
	LDA	TEMP4
	MUL	NUMCOLS
	STA	TEMP4
	LDA	ROWA
	SUB	TEMP4
	STA	TEMP4
	LD2	TEMP4
	JMP	MAXCOL
* does the maxcol and minrow addresses agree? (I2 =? ROWA)
	CMP2	ROWA
	JE	FOUND
* check row for more mins
	ST6	TEMP4
	LD2	TEMP4
	LD3	VAL
	STA	ROWA
	SUB	TEMP4
	STA	TEMP4
	LD4	TEMP4
	JMP	FVROW
* is there another min?
	CMP2	=-1=
	JNE	ROWA
	INC6	NUMCOLS
* are we out of rows?
	CMP6	=1073=
	JG	NOFOUND
	JMP	TEMP4
NOFOUND	ENT1	0
	HLT
FOUND	LD1	ROWA
	HLT
**********
	END	MAIN
