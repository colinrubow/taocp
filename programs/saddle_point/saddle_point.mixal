* TAOCP 1.3.2 ex 10, finds a saddle point in a 9x8 matrix
*
MATRIX	EQU	1009		The first element of the matrix
NUMROWS	EQU	9		number of rows
NUMCOLS	EQU	8		number of columns
	ORIG	0
RFIRST	NOP
TEMPA	NOP
TEMPB	NOP	
TEMPC	NOP
TEMPD	NOP
TEMPE	NOP
TEMPF	NOP
MINROW	ORIG	*+19		gets the min address in the row
ISMAXC	ORIG	*+19		gets the max address in the column
FVROW	ORIG	*+19		finds a value in the row
MAIN	ORIG	*
**********
* implement MINROW
* rI2 will hold the min address and should be initialized with the first address of the row
* rI3 will be used to store the min value
* rI4 will be used to count comparisons
* rI5 will be used to store the next address
* rA is used
	ORIG	MINROW
	STJ	0F
* initialize
	ST2	RFIRST
	LD3	0,2
	ENT4	0
NEXTVAL	INC4	1
* checked all values?
	CMP4	=NUMCOLS=
	JE	0F
* is current val less than the current?
	ST4	TEMPA
	LDA	TEMPA
	ADD	RFIRST
	STA	TEMPA
	LD5	TEMPA
	CMP3	0,5
	JLE	NEXTVAL
* swap for new min
	LD2	TEMPA
	LD3	0,2
	JMP	NEXTVAL
* found the min
0H	JMP	*-*
**********
* implement ISMAXC
* rI2 initialize with the first address of the column. If val is max, positive. If otherwise, negative
* rI3 is initialized with the tested value
* rI4 will be used to count
* rI5 will be used to store the next address
* rA is used
	ORIG	ISMAXC
	STJ	0F
* initialize
	ENT4	-1
NEXTV	INC4	1
* checked all values?
	CMP4	=NUMROWS=
	JE	0F
* is current val greater than the test value?
	ST4	TEMPB
	LDA	TEMPB
	MUL	=NUMCOLS=
	SLAX	5
	ST2	TEMPB
	ADD	TEMPB
	STA	TEMPB
	LD5	TEMPB
	CMP3	0,5
	JL	1F
	JMP	NEXTV
1H	ENT2	-1
0H	JMP	*-*
**********
* implement FVROW
* rI2 should be initialized with the first address of the row. Will hold the address of the next value or -1 if no other value
* rI3 should be initialized with the value to search for
* rI4 should be initialized with the distance from the first address to start
* rI5 is used
* rA is used
	ORIG	FVROW
	STJ	0F
NEXT	INC4	1
* checked all values?
	CMP4	=NUMCOLS=
	JE	NOFIND
* found one?
	ST2	TEMPC
	LDA	TEMPC
	ST4	TEMPC
	ADD	TEMPC
	STA	TEMPC
	LD5	TEMPC
	CMP3	0,5
	JNE	NEXT
	JMP	FIND
* did not find one
NOFIND	ENT2	-1
	JMP	0F
* found one
FIND	LD2	TEMPC
0H	JMP	*-*
**********
* MAIN program
	ORIG	MAIN
	ENT6	MATRIX
	ENT1	0
* get row min
NXTROW	ST6	TEMPD
	LD2	TEMPD
	JMP	MINROW
ROWA	ST2	TEMPE
	ST3	TEMPF
* see if max
	ST1	TEMPD
	LDA	TEMPD
	MUL	NUMCOLS
	SLAX	5
	STA	TEMPD
	LDA	TEMPE
	SUB	TEMPD
	STA	TEMPD
	LD2	TEMPD
	JMP	ISMAXC
	J2P	FOUND
* check row for more mins
	ST6	TEMPD
	LD2	TEMPD
	LD3	TEMPF
	LDA	TEMPE
	SUB	TEMPD
	STA	TEMPD
	LD4	TEMPD
	JMP	FVROW
* is there another min?
	CMP2	=-1=
	JNE	ROWA
	INC6	NUMCOLS
* are we out of rows?
	CMP6	=1073=
	JG	NOFOUND
	JMP	NXTROW
NOFOUND	ENT1	0
	HLT
FOUND	LD1	TEMP
	HLT
**********
	END	MAIN
