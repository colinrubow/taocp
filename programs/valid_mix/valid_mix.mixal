**********
* Check A
	STJ	0F
* is I == 0?
	CMP3	=0=
	JNE	BAD
* is A >= 0?
	CMP1	=0=
	JL	BAD
* is A <= 3999
	CMP1	=3999=
	JG	BAD
0H	JMP	*-*
**********
* Check FN (normal)
	STJ	0F
* is F < 0?
	CMP2	=0=
	JL	BAD
* is F <= 5?
	CMP2	=5=
	JLE	0F
* is F < 9?
	CMP2	=9=
	JL	BAD
* is F <= 13?
	CMP2	=13=
