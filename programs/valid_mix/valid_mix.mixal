* TAOCP 1.3.2 ex 9 will determine if the contents of location INST is a through and true MIX command
*
INST	EQU	0		The address to test
	ORIG	1
GOOD	ORIG	*+3
BAD	ORIG	*+3
TABLE	ORIG	*+64*4		The table is defined below and following are defined after the main code
CHKA	ORIG	*+8
CHKFN	ORIG	*+24
CHKF2	ORIG	*+6
CHKF3	ORIG	*+6
CHKF5	ORIG	*+6
CHKF9	ORIG	*+6
CHKF20	ORIG	*+6
**********
* 1. Check I
BEGIN	LD3	INST(3:3)
* is I >= than 0?
	CMP3	=0=
	JL	BAD
* is I <= than 6?
	CMP3	=6=
	JG	BAD
* 2. Check C
	LD3	INST(5:5)
* is C >= than 0?
	CMPA	=0=
	JL	BAD
* is C <= than 63
	CMPA	=63=
	JG	BAD
* 3. and 4. check table for F and +-AA
	LD1	INST(0:2)
	LD2	INST(4:4)
	MUL	=4=
0H	STX	*
	LD3	0B
	JMP	TABLE,3
	JMP	GOOD
**********
* implement GOOD
	ORIG	GOOD
	ENTA	7
	HLT
**********
* implement BAD
	ORIG	BAD
	ENTA	666
	HLT
**********
* implement TABLE
	ORIG	TABLE
* C = 00
	STJ	0F
	NOP
	NOP
