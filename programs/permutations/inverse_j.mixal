* TAOCP 1.3.3 computes the inverse of a permutation in place N is the number of elements and X is the starting address of the elements
*
* rI1 is m, rI2 is j, rI3 is -i
*
***** TESTING BLOCK *****
X	EQU	0
N	EQU	6
START	EQU	15
	ORIG	START
* permutation 621543
	ENTA	6
	STA	1
	ENTA	2
	STA	2
	ENTA	1
	STA	3
	ENTA	5
	STA	4
	ENTA	4
	STA	5
	ENTA	3
	STA	6
***** END TESTING BLOCK *****
INVERT	ENN1	N		J1. Negate all
	ST1	X+N+1,1(0:0)
	INC1	1
	J1N	*-2
	ENT1	N
2H	ENN3	0,1		J2. Initialize
	ENN2	0,3
	LD3N	X,2		J3. Find negative entry
	J3N	*-2
	LDA	X,3		J4. Invert
	STA	X,2
	ST1	X,3
	DEC1	1		J5. Loop on m
	J1P	2B
***** TESTING BLOCK *****
	HLT
	END	START
***** END TESTING BLOCK *****
