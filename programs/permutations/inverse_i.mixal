* TAOCP 1.3.3 computes the inverse of a permutation in place
* N is the number of elements and X is the starting address of the elements
*
* rI1 is m, rI2 is -i, rI3 is j
*
***** TESTING BLOCK *****
X	EQU	0
N	EQU	6
START	EQU	15
	ORIG	START
* permutation 621543
	ENTA	6
	STA	1
	ENTA	2
	STA	2
	ENTA	1
	STA	3
	ENTA	5
	STA	4
	ENTA	4
	STA	5
	ENTA	3
	STA	6
***** END TESTING BLOCK *****
INVERT	ENT1	N	I1. Initialize
	ENT3	-1
2H	LD2N	X,1	I2. Next element
	J2P	5F
3H	ST3	X,1	I3. Invert one
	ENN3	0,1
	ENN1	0,2
	LD2N	X,1
4H	J2N	3B	I4. End of cycle?
	ENN2	0,3
5H	ST2	X,1	I5. Store final value
6H	DEC1	1	I6. Loop on m
	J1P	2B
***** TESTING BLOCK *****
	HLT
	END	START
***** END TESTING BLOCK *****
